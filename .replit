modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-release"

[[workflows.workflow]]
name = "api-release"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:release"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
BUSINESS_EMAIL = "redacted@example.invalid"
EMAIL_FROM = "RZ Home Appliances Care <redacted@example.invalid>"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_REQUIRE_TLS = "true"
SMTP_SECURE = "false"
SMTP_USER = "redacted@example.invalid"
