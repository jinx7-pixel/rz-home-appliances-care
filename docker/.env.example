# Synthetic local examples only. Copy to docker/.env.local and replace these.
# Keep DB user/password/name URI-safe (letters, digits, underscore) in this local topology.
POSTGRES_USER=rz_local
POSTGRES_PASSWORD=replace_with_unique_local_only_password
POSTGRES_DB=rz_phase2_local
ADMIN_PASSWORD=replace_with_unique_local_only_admin_password
WEB_PORT=8080
APP_BASE_URL=https://localhost.invalid
LOG_LEVEL=info
# Leave SMTP empty for smoke checks; sends will be recorded as failed, not silently mocked.
SMTP_HOST=
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=
OWNER_EMAIL=
